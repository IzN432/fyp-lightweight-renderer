#version 450

// Animates a gridSize x gridSize lattice of instances and compacts the ones inside a (breathing)
// visible radius into `instances`, counting them into the indirect draw command.
// examples/python/gpu_instancing.py re-implements this in numpy to check the readback.
layout(local_size_x = 64) in;

struct Instance
{
    vec4 offsetScale; // xyz = position, w = scale
    vec4 color;
};

layout(set = 0, binding = 0) writeonly buffer Instances
{
    Instance instances[];
};

layout(set = 0, binding = 1) buffer DrawArgs
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
} args;

layout(push_constant) uniform PC
{
    float time;
    uint  gridSize;
    float spacing;
    float visibleRadius;
} pc;

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.gridSize * pc.gridSize)
    {
        return;
    }

    const vec2  cell   = vec2(float(i % pc.gridSize), float(i / pc.gridSize)) - 0.5 * float(pc.gridSize - 1u);
    const vec2  xz     = cell * pc.spacing;
    const float d      = length(xz);
    const float radius = pc.visibleRadius * (0.75 + 0.25 * sin(pc.time * 0.7));
    if (d > radius)
    {
        return;
    }

    const uint slot                 = atomicAdd(args.instanceCount, 1u);
    instances[slot].offsetScale     = vec4(xz.x, 0.6 * sin(d * 0.35 - pc.time * 2.0), xz.y, 0.4);
    instances[slot].color           = vec4(0.5 + 0.5 * cos(vec3(0.0, 2.1, 4.2) + d * 0.15 - pc.time), 1.0);
}
