#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputValues
{
    float values[];
} inputValues;

layout(set = 0, binding = 1) writeonly buffer OutputValues
{
    float values[];
} outputValues;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    outputValues.values[index] = inputValues.values[index] * 2.0;
}
