#version 450

// Solver stage: commit this iteration's corrections and re-confine the particles to the domain.
// The second loop of FluidSolverCpu::computePositionCorrections, followed by
// FluidSolverCpu::resolveBoundaryCollisions.
//
// Positions only. The velocity update at the end of the step derives velocity from total
// displacement, so anything written to velocities here would be discarded; contact response belongs
// with that update, in fluid_finalise.comp.

#include "fluid_sim.glslh"
#include "fluid_obstacle.glslh"

layout(local_size_x = FLUID_WORKGROUP_SIZE) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount())
        return;

    vec3 previous = predicted[i].xyz;
    vec3 position = clamp(previous + corrections[i].xyz, domainMin(), domainMax());
    vec3 obstacleNormal;
    if (sweepObstacle(previous, position, obstacleNormal))
        contactNormals[i] = vec4(obstacleNormal, 0.0);
    predicted[i] = vec4(position, 0.0);
}
