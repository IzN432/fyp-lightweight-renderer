#version 450

// Commit the bucket-ordered state. cellParticles becomes the identity permutation, which removes
// one dependent lookup from every subsequent neighbour visit in this step.

#include "fluid_sim.glslh"

layout(local_size_x = FLUID_WORKGROUP_SIZE) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount())
        return;

    positions[i]     = sortedPositions[i];
    velocities[i]    = sortedVelocities[i];
    predicted[i]     = sortedPredicted[i];
    particleCells[i] = sortedParticleCells[i];
    particleIds[i]   = sortedParticleIds[i];
    cellParticles[i] = i;
}
