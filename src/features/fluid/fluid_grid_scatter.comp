#version 450

// Spatial hash, pass 3: scatter each particle into its bucket's span -- the fill pass of the
// counting sort.
//
// FluidSolverCpu walks a cursor copy of the start offsets so the offsets themselves survive for the
// lookup. Here the cursor is an atomic counter per bucket: cellCounts has served its purpose as the
// tally by now (the scan has consumed it into cellStarts), so it is re-zeroed by the scan pass and
// reused as that cursor rather than allocating a fourth grid buffer.
//
// The order within a bucket therefore depends on the order the atomics resolve in, where the CPU
// reference fills each span in ascending particle index. Neighbour sets are identical either way;
// only the order they are visited in differs, and every stage that consumes them accumulates
// commutatively. Float addition is not associative, so this is the one place the two solvers can
// disagree in the last bits -- which is why the diff test compares with a tolerance rather than
// bit-exactly.

#include "fluid_sim.glslh"

layout(local_size_x = FLUID_WORKGROUP_SIZE) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount())
        return;

    ivec3 cell  = cellForPosition(predicted[i].xyz);
    uint  bucket = bucketForCell(cell);
    uint  slot   = cellStarts[bucket] + atomicAdd(cellCounts[bucket], 1u);
    cellParticles[slot] = i;

    // Recorded so the neighbour traversal can tell which cell this particle was filed under once
    // the constraint iterations have moved it; see ParticleCells in fluid_sim.glslh. w is padding:
    // a std430 array of ivec3 has a 16-byte stride regardless.
    particleCells[i] = ivec4(cell, 0);
}
