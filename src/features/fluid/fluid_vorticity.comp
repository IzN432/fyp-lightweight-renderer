#version 450

// Equation (15): estimate curl at every particle. A separate pass is required because equation
// (16) differentiates the completed vorticity magnitudes of neighbouring particles.

#include "fluid_sim.glslh"

layout(local_size_x = FLUID_WORKGROUP_SIZE) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount())
        return;

    if (vorticityEpsilon() <= 0.0)
    {
        vorticities[i] = vec4(0.0);
        return;
    }

    float h = smoothingRadius();
    vec3 self = positions[i].xyz;
    vec3 velocity = velocities[i].xyz;
    vec3 omega = vec3(0.0);

    FLUID_FOR_EACH_NEIGHBOUR(i, j, {
        vec3 offset = self - positions[j].xyz;
        if (dot(offset, offset) < h * h)
            // v_ij x grad_pj W, written as grad_pi W x v_ij; see FluidSolverCpu for the sign.
            omega += cross(spikyGradient(offset, h), velocities[j].xyz - velocity);
    })

    vorticities[i] = vec4(omega, 0.0);
}
