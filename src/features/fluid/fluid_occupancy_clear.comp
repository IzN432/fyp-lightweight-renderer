#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, r32ui) uniform writeonly uimage2D occupancyImage;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(occupancyImage);
    if (any(greaterThanEqual(pixel, size)))
        return;

    imageStore(occupancyImage, pixel, uvec4(0u));
}
