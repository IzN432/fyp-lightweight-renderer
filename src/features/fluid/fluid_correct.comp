#version 450

// Solver stage: the position correction implied by this iteration's lambdas. Transcribed from the
// first loop of FluidSolverCpu::computePositionCorrections.
//
// Written to a separate buffer rather than applied in place, for the reason given there: every
// correction has to be built from the same iteration's lambdas and predicted positions. In place
// the result would depend on the order particles happened to be processed in -- which on the GPU is
// not even deterministic between runs. fluid_apply.comp commits them once all are known.

#include "fluid_sim.glslh"

layout(local_size_x = FLUID_WORKGROUP_SIZE) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount())
        return;

    float h = smoothingRadius();
    vec3 self = predicted[i].xyz;
    float lambdaSelf = lambdas[i];

    vec3 correction = vec3(0.0);
    FLUID_FOR_EACH_NEIGHBOUR(i, j, {
        vec3 offset = self - predicted[j].xyz;
        if (dot(offset, offset) < h * h)
        {
            // The symmetric (lambda_i + lambda_j) weight is what makes each pair push itself apart
            // equally and oppositely, conserving momentum.
            correction += (lambdaSelf + lambdas[j]) * spikyGradient(offset, h);
        }
    })

    corrections[i] = vec4(correction / restDensity(), 0.0);
}
