#version 450

// Solver stage: commit the blended velocities computed by fluid_viscosity.comp, completing the
// step. Separate pass for the same reason the position corrections are: the blend has to read an
// unmodified velocity field.

#include "fluid_sim.glslh"

layout(local_size_x = FLUID_WORKGROUP_SIZE) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount())
        return;

    vec3 velocity = corrections[i].xyz;
    float maxSpeed = maxSpeedRadii() * smoothingRadius();
    float speedSquared = dot(velocity, velocity);
    if (maxSpeed > 0.0 && speedSquared > maxSpeed * maxSpeed)
        velocity *= maxSpeed / sqrt(speedSquared);
    velocities[i] = vec4(velocity, 0.0);
}
