#version 450

// Stage 1: apply gravity and advance positions by velocity, giving the predicted positions the
// constraint solve then corrects in place. FluidSolverCpu::step does this in its first loop.

#include "fluid_sim.glslh"

layout(local_size_x = FLUID_WORKGROUP_SIZE) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount())
        return;

    vec3 velocity = velocities[i].xyz + gravity() * deltaTime();
    velocity = clampStepDisplacement(velocity * deltaTime()) / deltaTime();
    velocities[i] = vec4(velocity, 0.0);
    predicted[i]  = vec4(positions[i].xyz + velocity * deltaTime(), 0.0);
}
