#version 450

// Equation (16): f_vorticity = epsilon (N x omega), where N is the normalized gradient of
// vorticity magnitude. This is a velocity post-process, so the force is integrated over dt.

#include "fluid_sim.glslh"

layout(local_size_x = FLUID_WORKGROUP_SIZE) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount() || vorticityEpsilon() <= 0.0)
        return;

    float h = smoothingRadius();
    vec3 self = positions[i].xyz;
    vec3 eta = vec3(0.0);

    FLUID_FOR_EACH_NEIGHBOUR(i, j, {
        vec3 offset = self - positions[j].xyz;
        if (dot(offset, offset) < h * h)
            eta += length(vorticities[j].xyz) * spikyGradient(offset, h);
    })

    float etaLength = length(eta);
    if (etaLength > 1e-6)
    {
        vec3 direction = eta / etaLength;
        vec3 force = vorticityEpsilon() * cross(direction, vorticities[i].xyz);
        velocities[i] = vec4(velocities[i].xyz + deltaTime() * force, 0.0);
    }
}
