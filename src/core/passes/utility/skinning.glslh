#ifndef LR_SKINNING_GLSLH
#define LR_SKINNING_GLSLH

#include "skinning_types.glslh"

#if !defined(LR_SKIN_INFLUENCES) || !defined(LR_SKIN_INFLUENCE_OFFSETS) || \
    !defined(LR_SKIN_POSITION_INDICES) || !defined(LR_SKIN_JOINT_MATRICES)
#error "Define the LR_SKIN_* array aliases before including skinning.glslh"
#endif

mat4 calculateSkinMatrix(uint vertexIndex, uint paletteOffset)
{
    uint uniquePosition = LR_SKIN_POSITION_INDICES[vertexIndex];
    uint begin = LR_SKIN_INFLUENCE_OFFSETS[uniquePosition];
    uint end = LR_SKIN_INFLUENCE_OFFSETS[uniquePosition + 1];

    mat4 skinMatrix = mat4(0.0);
    float weightSum = 0.0;
    for (uint influenceIndex = begin; influenceIndex < end; ++influenceIndex)
    {
        SkinInfluence influence = LR_SKIN_INFLUENCES[influenceIndex];
        skinMatrix += influence.weight * LR_SKIN_JOINT_MATRICES[paletteOffset + influence.jointIndex];
        weightSum += influence.weight;
    }

    return weightSum > 0.0 ? skinMatrix / weightSum : mat4(1.0);
}

#endif
