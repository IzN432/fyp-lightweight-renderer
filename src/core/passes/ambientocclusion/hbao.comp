#version 450

#define PI 3.14159265f

#include "../utility/geometry.glslh"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 view;
    mat4 proj;
    mat4 viewProj;
    mat4 invView;
    mat4 invProj;
    vec3 cameraPosition;
    float padding;
} cam;

layout(set = 0, binding = 1) uniform sampler2D depthTex;   // full-res G-buffer depth

layout(set = 0, binding = 3) uniform AOParam {
    vec4  sphereRadius; // r, r^2, 1/r, 0
    int   numSteps;
    int   numDirs;
    float tanAngleBias;
    float aoScalar;
} aoInfo;

layout(set = 0, binding = 4, r32f) uniform writeonly image2D aoOut;

// Cheap per-pixel hash (Dave Hoskins' hash12) — used instead of a small repeating noise texture
// for the per-pixel rotation/jitter below. A tiled texture (we previously used a 4x4 tile) only
// has as many distinct values as the tile has texels, so it produces a visible periodic pattern
// wherever the underlying AO signal varies sharply (e.g. along a silhouette edge) that an
// edge-preserving blur can't remove, since it deliberately doesn't blend across that same edge.
// This gives every pixel its own value with no repeating period at all.
float hash12(vec2 p)
{
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float tangentToSin(float tangent)
{
    return tangent * inversesqrt(tangent * tangent + 1.0);
}

// Choose the shorter one-sided depth derivative. At depth discontinuities this avoids using the
// foreground-to-background vector as the receiver's tangent, following the reference HBAO method.
vec3 minDiff(vec3 P, vec3 positive, vec3 negative)
{
    vec3 forward  = positive - P;
    vec3 backward = P - negative;
    return dot(forward, forward) < dot(backward, backward) ? forward : backward;
}

void main()
{
    ivec2 pos  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(aoOut);
    if (pos.x >= size.x || pos.y >= size.y)
        return;

    float depth = texelFetch(depthTex, pos, 0).r;
    if (depth >= 1.0)
    {
        imageStore(aoOut, pos, vec4(0.0));
        return;
    }

    vec2 texel  = 1.0 / vec2(size);
    vec3 P      = depthToViewPosition(depth, (vec2(pos) + 0.5) * texel, cam.invProj);

    // Reconstruct the local receiver tangent basis from depth, rather than deriving a tangent
    // angle from the normal. This is the formulation used by the reference NVIDIA-style HBAO:
    // it follows the actually visible surface and naturally includes perspective projection.
    ivec2 rightPos = min(pos + ivec2(1, 0), size - 1);
    ivec2 leftPos  = max(pos - ivec2(1, 0), ivec2(0));
    ivec2 downPos  = min(pos + ivec2(0, 1), size - 1);
    ivec2 upPos    = max(pos - ivec2(0, 1), ivec2(0));
    vec3 Pr = depthToViewPosition(texelFetch(depthTex, rightPos, 0).r, (vec2(rightPos) + 0.5) * texel, cam.invProj);
    vec3 Pl = depthToViewPosition(texelFetch(depthTex, leftPos, 0).r, (vec2(leftPos) + 0.5) * texel, cam.invProj);
    vec3 Pd = depthToViewPosition(texelFetch(depthTex, downPos, 0).r, (vec2(downPos) + 0.5) * texel, cam.invProj);
    vec3 Pu = depthToViewPosition(texelFetch(depthTex, upPos, 0).r, (vec2(upPos) + 0.5) * texel, cam.invProj);
    vec3 dPdx = minDiff(P, Pr, Pl);
    vec3 dPdy = minDiff(P, Pd, Pu);

    // View-space sphere radius projected to pixels. proj[1][1] is negated (Y flip), hence abs.
    float radiusPx = aoInfo.sphereRadius.x * abs(cam.proj[1][1]) / -P.z * 0.5 * float(size.y);
    // Clamped to at least 1px per step — below that, consecutive steps floor() onto the same texel,
    // making V a zero vector (S == P) and V.z / length(V) a NaN that corrupts max() for the rest of
    // the direction. This only trades away some radius precision once a surface is far enough from
    // the camera that the whole sample radius is sub-pixel anyway.
    float stepPx = max(radiusPx / float(aoInfo.numSteps), 1.0);

    // This pixel's random rotation (cos, sin) and step-distance jitter, from independent hashes
    // (different seed offsets) so they aren't correlated with each other.
    float noiseAngle = hash12(vec2(pos)) * 2.0 * PI;
    vec2  noise       = vec2(cos(noiseAngle), sin(noiseAngle));
    float jitter       = hash12(vec2(pos) + vec2(19.19, 7.29));

    float occlusion = 0.0;
    for (int i = 0; i < aoInfo.numDirs; i++)
    {
        // numDirs evenly spaced directions, rotated by the per-pixel noise.
        float angle = 2.0 * PI * float(i) / float(aoInfo.numDirs);
        vec2  base  = vec2(cos(angle), sin(angle));
        vec2  dir   = vec2(base.x * noise.x - base.y * noise.y,
                           base.x * noise.y + base.y * noise.x); // pixel space, +y is down the screen

        // Starting horizon: elevation tangent of the receiver itself along this screen-space ray.
        vec3 tangentVector = dir.x * dPdx + dir.y * dPdy;
        float tangentXYLength = length(tangentVector.xy);
        if (tangentXYLength < 1e-8)
            continue;
        float maxTan = tangentVector.z / tangentXYLength + aoInfo.tanAngleBias;
        float maxSin = tangentToSin(maxTan);

        // Running horizon accumulation (Bavoil et al.). maxTan determines whether a sample raises
        // the horizon; maxSin stores the same angle in the projected form used by the AO integral.
        // Each newly revealed slice is weighted by that sample's own distance falloff.
        float wao    = 0.0;
        for (int s = 1; s <= aoInfo.numSteps; s++)
        {
            vec2  samplePx = vec2(pos) + 0.5 + dir * (stepPx * (float(s) + jitter));
            ivec2 samplePos = ivec2(floor(samplePx));
            if (samplePos.x < 0 || samplePos.y < 0 || samplePos.x >= size.x || samplePos.y >= size.y)
                break;

            float sampleDepth = texelFetch(depthTex, samplePos, 0).r;
            if (sampleDepth >= 1.0)
                continue;

            vec3 S = depthToViewPosition(sampleDepth, (vec2(samplePos) + 0.5) * texel, cam.invProj);
            vec3  V     = S - P;
            float VdotV = dot(V, V);
            if (VdotV >= aoInfo.sphereRadius.y) // r^2
                continue;
            if (VdotV < 1e-8) // avoid NaN from V.z / length(V)
                continue;

            float horizontalLength = length(V.xy);
            if (horizontalLength < 1e-8)
                continue;
            float sampleTan = V.z / horizontalLength;

            if (sampleTan > maxTan)
            {
                float sampleSin = tangentToSin(sampleTan);
                // Distance falloff: W(r) = 1 - r^2 where r = ||S - P|| / R. Discounts a sample's
                // contribution as it gets farther from P, reaching zero at the sphere radius — without
                // this, a sample that happens to fall within the pixel-space step radius but is
                // actually far away in view space (e.g. background behind a silhouette edge) would
                // count as a full-strength occluder, which is what produced the outline/halo artifact
                // around the model.
                float falloff = clamp(1.0 - VdotV / aoInfo.sphereRadius.y, 0.0, 1.0);
                wao += falloff * (sampleSin - maxSin);
                maxTan = sampleTan;
                maxSin = sampleSin;
            }
        }

        occlusion += wao;
    }

    float ao = clamp((occlusion / float(aoInfo.numDirs)) * aoInfo.aoScalar, 0.0, 1.0);
    imageStore(aoOut, pos, vec4(ao, 0.0, 0.0, 0.0));
}
