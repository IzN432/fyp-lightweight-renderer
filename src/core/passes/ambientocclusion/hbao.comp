#version 450

#define PI 3.14159265f

#include "../utility/geometry.glslh"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 view;
    mat4 proj;
    mat4 viewProj;
    mat4 invView;
    mat4 invProj;
    vec3 cameraPosition;
    float padding;
} cam;

layout(set = 0, binding = 1) uniform sampler2D depthTex;   // full-res G-buffer depth
layout(set = 0, binding = 2) uniform sampler2D normalTex;  // full-res G-buffer normal
layout(set = 0, binding = 3) uniform sampler2D directionTex;

layout(set = 0, binding = 4) uniform AOParam {
    vec4  sphereRadius; // r, r^2, 1/r, 0
    int   numSteps;
    int   numDirs;
    float tanAngleBias;
    float aoScalar;
} aoInfo;

layout(set = 0, binding = 5, r32f) uniform writeonly image2D aoOut;

void main()
{
    ivec2 pos  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(aoOut);
    if (pos.x >= size.x || pos.y >= size.y)
        return;

    float depth = texelFetch(depthTex, pos, 0).r;
    if (depth >= 1.0)
    {
        imageStore(aoOut, pos, vec4(0.0));
        return;
    }

    vec2 texel  = 1.0 / vec2(size);
    vec3 P      = depthToViewPosition(depth, (vec2(pos) + 0.5) * texel, cam.invProj);
    vec3 N      = unpackViewNormal(texelFetch(normalTex, pos, 0).rg);
    float nz    = max(N.z, 1e-3);

    // View-space sphere radius projected to pixels. proj[1][1] is negated (Y flip), hence abs.
    float radiusPx = aoInfo.sphereRadius.x * abs(cam.proj[1][1]) / -P.z * 0.5 * float(size.y);
    float stepPx   = radiusPx / float(aoInfo.numSteps);

    // This pixel's random rotation from the 4x4 tile (cos, sin).
    vec2 noise = texelFetch(directionTex, pos & 3, 0).rg;

    float occlusion = 0.0;
    for (int i = 0; i < aoInfo.numDirs; i++)
    {
        // numDirs evenly spaced directions, rotated by the per-pixel noise.
        float angle = 2.0 * PI * float(i) / float(aoInfo.numDirs);
        vec2  base  = vec2(cos(angle), sin(angle));
        vec2  dir   = vec2(base.x * noise.x - base.y * noise.y,
                           base.x * noise.y + base.y * noise.x); // pixel space, +y is down the screen

        // Same direction in view space (proj Y flip: pixel +y is view -y), and the tangent
        // plane's elevation along it.
        vec2  dirView = vec2(dir.x, -dir.y);
        float tz      = -(N.x * dirView.x + N.y * dirView.y) / nz;
        float sinT    = tz / length(vec3(dirView, tz));

        float maxSin = sinT;
        for (int s = 1; s <= aoInfo.numSteps; s++)
        {
            vec2  samplePx = vec2(pos) + 0.5 + dir * (stepPx * float(s));
            ivec2 samplePos = ivec2(floor(samplePx));
            if (samplePos.x < 0 || samplePos.y < 0 || samplePos.x >= size.x || samplePos.y >= size.y)
                break;

            float sampleDepth = texelFetch(depthTex, samplePos, 0).r;
            if (sampleDepth >= 1.0)
                continue;

            vec3 S = depthToViewPosition(sampleDepth, (vec2(samplePos) + 0.5) * texel, cam.invProj);
            vec3 V = S - P;
            maxSin = max(maxSin, V.z / length(V));
        }

        occlusion += maxSin - sinT;
    }

    imageStore(aoOut, pos, vec4(occlusion / float(aoInfo.numDirs), 0.0, 0.0, 0.0));
}
