{
    "version": 3,
    "configurePresets": [
        {
            "name": "vcpkg-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "base-debug",
            "inherits": "vcpkg-base",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "base",
            "displayName": "Debug",
            "configurePreset": "base-debug",
            "configuration": "Debug",
            "jobs": 16
        },
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "base-debug",
            "configuration": "Release",
            "jobs": 16
        }
    ]
}